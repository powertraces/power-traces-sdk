<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>PowerTraces.MongoDb</PackageId>
    <Description>MongoDB provider for PowerTraces — exports traces/logs
      straight to MongoDB via connection string, no EF Core, collections/indexes created
      automatically.</Description>
    <PackageTags>opentelemetry;telemetry;tracing;logging;mongodb;mongo;observability</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="MongoDB.Driver" Version="3.11.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PowerTraces\PowerTraces.csproj" />
  </ItemGroup>

</Project>
