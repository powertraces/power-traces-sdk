<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>PowerTraces.PostgreSQL</PackageId>
    <Description>PostgreSQL provider for PowerTraces — exports traces/logs
      straight to PostgreSQL via connection string, no EF Core, tables created automatically.</Description>
    <PackageTags>opentelemetry;telemetry;tracing;logging;postgresql;postgres;observability</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PowerTraces\PowerTraces.csproj" />
  </ItemGroup>

</Project>
