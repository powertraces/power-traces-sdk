<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>PowerTraces</PackageId>
    <Description>Base package for exporting OpenTelemetry traces/logs straight to a database via
      connection string — no collector, no EF Core. Database-agnostic on its own; add
      PowerTraces.MSSQL, .PostgreSQL, .MongoDb, or .MySQL for a concrete
      database, or implement IStorageWriter yourself for any other one.</Description>
    <PackageTags>opentelemetry;telemetry;tracing;logging;observability</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry" Version="1.18.0" />
  </ItemGroup>

</Project>
