<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>PowerTraces.Sqlite</PackageId>
    <Description>SQLite provider for PowerTraces — exports traces/logs to a local SQLite file,
      no database server, tables created automatically.</Description>
    <PackageTags>opentelemetry;telemetry;tracing;logging;sqlite;observability</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PowerTraces\PowerTraces.csproj" />
  </ItemGroup>

</Project>
