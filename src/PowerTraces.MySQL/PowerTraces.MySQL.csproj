<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>PowerTraces.MySQL</PackageId>
    <Description>MySQL/MariaDB provider for PowerTraces — exports traces/logs
      straight to MySQL via connection string, no EF Core, tables created automatically.</Description>
    <PackageTags>opentelemetry;telemetry;tracing;logging;mysql;mariadb;observability</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PowerTraces\PowerTraces.csproj" />
  </ItemGroup>

</Project>
